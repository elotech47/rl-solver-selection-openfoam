# Large / generated / binary
**/platforms/
**/opt/
**/*.so
**/*.o
**/Make/linux*/
**/*.core
**/__pycache__/
**/.pytest_cache/
*.pt
*.pkl

# OpenFOAM case runtime
**/processor*/
**/postProcessing/
**/dynamicCode/
**/chemFoam.out
**/log.chemFoam*
**/0/[0-9]*
**/[0-9]*/
**/[0-9]*.*/

# Keep validation artifacts that are small text; ignore huge logs optionally
OPENFOAM_PATH/validation/zeroD/of_runs/**/*.log
OPENFOAM_PATH/validation/zeroD/e3_skeletal_dodecane/runs/log.*
# E9 GRI per-step CSVs are ~13MB each; report has the summary
OPENFOAM_PATH/validation/zeroD/e9_constprop/e8.gri_*.csv
OPENFOAM_PATH/validation/zeroD/e8_state/**/log.chemFoam
OPENFOAM_PATH/applications/solvers/chemFoam/Make/linux*/
# Transient dumps left in the live case directory
OPENFOAM_PATH/cases/chemFoam_0D/e8_*.csv
OPENFOAM_PATH/cases/chemFoam_0D/e8_*.dat

# E15 conformance — multi-GB trajectory dumps / scratch worktrees (maps & gates are tracked)
OPENFOAM_PATH/validation/zeroD/e15_conformance/of_runs/
OPENFOAM_PATH/validation/zeroD/e15_conformance/of_runs_tfreeze/
OPENFOAM_PATH/validation/zeroD/e15_conformance/of_work/
OPENFOAM_PATH/validation/zeroD/e15_conformance/of_work_tfreeze/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2_runs/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2_work/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2b_runs/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2b_work/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2c_runs/
OPENFOAM_PATH/validation/zeroD/e15_conformance/e15_2c_work/
OPENFOAM_PATH/validation/zeroD/e15_conformance/rung_b_midt/
OPENFOAM_PATH/validation/zeroD/e15_conformance/*.log
OPENFOAM_PATH/validation/zeroD/e15_conformance/*.tsv.bak*
OPENFOAM_PATH/validation/zeroD/e15_conformance/colima_start.log
OPENFOAM_PATH/validation/zeroD/e15_conformance/recover_platforms.log

