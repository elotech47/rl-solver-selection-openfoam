FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          chemistryProperties;
}

chemistryType
{
    solver          __SOLVER__;
}

chemistry       on;

initialChemicalTimeStep 1e-07;

qssCoeffs
{
    epsmin          0.02;
    epsmax          100;
    dtmin           1e-12;
    dtmax           1e-06;
    abstol          1e-11;
    itermax         2;
    // E15.3 CONFORM: freeze T/thermo on QSS corrector (handoff CanteraQSSODE).
    // Set false only for A/B attribution. CVODE ignores this key.
    Tfreeze         true;
}

cvodeCoeffs
{
    relTol          1e-08;
    absTol          1e-12;
    maxSteps        100000;
}

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-08;
}


