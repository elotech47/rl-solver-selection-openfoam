// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          chemistryProperties;
}

chemistryType
{
    solver          qss;
}

chemistry       on;

initialChemicalTimeStep 1e-06;

qssCoeffs
{
    epsmin          0.02;
    epsmax          100;
    dtmin           1e-12;
    dtmax           1e-06;
    abstol          1e-11;
    itermax         2;
}

cvodeCoeffs
{
    relTol          1e-08;
    absTol          1e-12;
    maxSteps        100000;
}

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-08;
}


