/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     reactingFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.02;
deltaT          1e-6;
writeControl    adjustableRunTime;
writeInterval   2e-4;
purgeWrite      40;
writeFormat     ascii;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.3;
maxDeltaT       1e-6;

libs
(
    "libqssChemistrySolver.so"
    "libcvodeChemistrySolver.so"
    "librlChemistryModel.so"
);
