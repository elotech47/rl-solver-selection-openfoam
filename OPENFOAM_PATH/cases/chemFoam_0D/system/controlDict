FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
application     chemFoamDebug;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.5e-3;
deltaT          1e-6;
writeControl    runTime;
writeInterval   1.5e-3;
purgeWrite      0;
writeFormat     ascii;
runTimeModifiable true;
adjustTimeStep  no;
maxDeltaT       1e-6;
libs
(
    "libqssChemistrySolver.so"
    "libcvodeChemistrySolver.so"
    "libpolicyRuntime.so"
    "librlChemistryModel.so"
);
