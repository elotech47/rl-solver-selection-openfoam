FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chemFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.0035;

deltaT          1e-07;

maxDeltaT       1e-07;

adjustTimeStep  yes;

writeControl    adjustable;

writeInterval   0.0005;

purgeWrite      0;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

libs            ( "libqssChemistrySolver.so" "libcvodeChemistrySolver.so" );

DebugSwitches
{
    SolverPerformance 0;
}

functions
{
}


