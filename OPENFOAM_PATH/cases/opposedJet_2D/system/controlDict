FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingFoamDebug;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// E17.1 scout: 3200 cells, CVODE, 10 atm, air 1350 K, U=±0.05
endTime         0.000107;

deltaT          1e-05;

writeControl    adjustableRunTime;

writeInterval   1e-05;

purgeWrite      0;

writeFormat     ascii;

writeCompression off;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.4;

maxDeltaT       1e-05;

libs            ( "libqssChemistrySolver.so" "libcvodeChemistrySolver.so" "libpolicyRuntime.so" "librlChemistryModel.so" );

propSanity      true;

propSanityInterval 10;

// Suppress per-equation "DILUPBiCGStab: Solving for …" residual spam (106 Yi).
DebugSwitches
{
    SolverPerformance 0;
}


