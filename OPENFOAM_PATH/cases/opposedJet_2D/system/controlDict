FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     reactingFoamDebug;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-05;

deltaT          1e-06;

writeControl    adjustableRunTime;

writeInterval   1e-05;

purgeWrite      20;

writeFormat     ascii;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.3;

maxDeltaT       1e-06;

libs            ( "libqssChemistrySolver.so" "libcvodeChemistrySolver.so" );


